<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Workspaces live in the app's Documents; these show them in the Files
	     app, as plain folders other apps can open in place. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- iPhone Pros run Core Animation at 120 Hz only when asked (iPads do
	     already): sheets and tabs animate on the compositor, so they gain. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The scene lifecycle (tao supports it): iPadOS builds the menu bar, and
	     windows, around scenes. One scene for now. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
</dict>
</plist>
